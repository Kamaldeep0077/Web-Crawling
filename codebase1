### Step 5: Main Orchestration Script

```python
# main.py
import argparse
import os
import logging
from gmd_crawler import GMDCrawler
from sharepoint import SharePointConnector
from data_processor import DataProcessor

# Set up logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler("gmd_automation.log"),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)

def main():
    parser = argparse.ArgumentParser(description='GMD Automation Tool')
    parser.add_argument('--model-id', required=True, help='Model ID to process')
    args = parser.parse_args()
    
    model_id = args.model_id
    logger.info(f"Starting GMD automation process for model {model_id}")
    
    try:
        # Step 1: Extract data from GMD
        crawler = GMDCrawler()
        gmd_extract_path = crawler.extract_model_data(model_id)
        logger.info(f"GMD extract downloaded to {gmd_extract_path}")
        
        # Step 2: Get latest validation report from SharePoint
        sharepoint = SharePointConnector()
        validation_report_path = sharepoint.get_latest_validation_report(model_id)
        logger.info(f"Latest validation report downloaded to {validation_report_path}")
        
        # Step 3: Process data and update validation report
        processor = DataProcessor()
        model_data = processor.process_gmd_extract(gmd_extract_path)
        updated_report_path = processor.update_validation_report(validation_report_path, model_data)
        logger.info(f"Updated validation report saved to {updated_report_path}")
        
        logger.info("Process completed successfully")
        
    except Exception as e:
        logger.error(f"Error occurred: {str(e)}", exc_info=True)
        return 1
    
    return 0

if __name__ == "__main__":
    exit(main())
```

